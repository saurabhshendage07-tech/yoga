# ==========================================
# PranaVeda Yoga Management System - Environment Config
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development
STUDIO_NAME="PranaVeda Yoga & Wellness"

# ------------------------------------------
# 1. FIREBASE CONFIGURATION (OPTIONAL FOR LIVE FIRESTORE)
# ------------------------------------------
# If not provided, backend automatically runs smoothly using local JSON database.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Use actual private key with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------
# Get these from https://dashboard.razorpay.com/#/app/keys
# If not provided or default test keys are used, system operates in seamless Interactive Demo Mode!
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------
# 3. WHATSAPP NOTIFICATION PROVIDER
# ------------------------------------------
# Choose Provider: META | TWILIO | SIMULATOR
WHATSAPP_PROVIDER=SIMULATOR

# If using Meta WhatsApp Cloud API:
META_WA_TOKEN=EAAxxxxxxx
META_PHONE_NUMBER_ID=100000000000000

# If using Twilio WhatsApp:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WA_PHONE_NUMBER=+14155238886

# ------------------------------------------
# 4. SMS NOTIFICATION PROVIDER
# ------------------------------------------
# Choose Provider: FAST2SMS | TWILIO | SIMULATOR
SMS_PROVIDER=SIMULATOR

# If using Fast2SMS (Indian SMS Gateway):
FAST2SMS_API_KEY=your_fast2sms_api_key

# If using Twilio SMS:
TWILIO_SMS_PHONE_NUMBER=+1234567890
